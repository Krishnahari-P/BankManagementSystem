@model BankManagementSystem.Client.Dto.EmployeeResponse
@{
    ViewData["Title"] = "Details";
    Layout = "_DetailsLayout";
}

<div class="container mt-3 mb-3">
    <div class="row justify-content-center">
        <div class="col-lg-9 col-md-10">
            <div class="card shadow-lg border-0">
                <div class="card-header text-white py-2" style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="bi bi-person-badge me-2"></i>Employee Details</h5>
                    </div>
                </div>
                <div class="card-body p-3">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="detail-box">
                                <small class="text-muted d-block mb-1">
                                    <i class="bi bi-hash me-1"></i>@Html.DisplayNameFor(model => model.StaffCode)
                                </small>
                                <strong>@Html.DisplayFor(model => model.StaffCode)</strong>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="detail-box">
                                <small class="text-muted d-block mb-1">
                                    <i class="bi bi-person me-1"></i>@Html.DisplayNameFor(model => model.EmployeeName)
                                </small>
                                <strong>@Html.DisplayFor(model => model.EmployeeName)</strong>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="detail-box">
                                <small class="text-muted d-block mb-1">
                                    <i class="bi bi-telephone me-1"></i>@Html.DisplayNameFor(model => model.Phone)
                                </small>
                                <strong>@Html.DisplayFor(model => model.Phone)</strong>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="detail-box">
                                <small class="text-muted d-block mb-1">
                                    <i class="bi bi-briefcase me-1"></i>@Html.DisplayNameFor(model => model.JobTitle)
                                </small>
                                <strong>@Html.DisplayFor(model => model.JobTitle)</strong>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="detail-box">
                                <small class="text-muted d-block mb-1">
                                    <i class="bi bi-calendar-check me-1"></i>@Html.DisplayNameFor(model => model.HiredDate)
                                </small>
                                <strong>@Html.DisplayFor(model => model.HiredDate)</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    dl.row {
        display: flex;
        flex-wrap: wrap;
    }

        dl.row dt {
            flex: 0 0 25% !important;
            font-weight: 600;
            text-align: right;
            padding-right: 10px;
            align-self: center;
        }

        dl.row dd {
            flex: 0 0 70% !important;
            margin: 0 !important;
            align-self: center;
            word-break: break-word;
        }

    .card {
        border-radius: 12px;
        overflow: hidden;
    }

    .detail-box {
        background: #f8f9fa;
        padding: 0.75rem;
        border-radius: 8px;
        border-left: 3px solid #2a5298;
        height: 100%;
    }

        .detail-box strong {
            color: #333;
            font-size: 1rem;
        }

    .btn-light:hover {
        background-color: #fff;
        transform: translateY(-1px);
    }
</style>