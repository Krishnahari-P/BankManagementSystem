@model IEnumerable<BankManagementSystem.Client.Dto.EmployeeResponse>

@{
    ViewData["Title"] = "Employee Management";
}
<div class="modal" id="myModal">
    <div class="modal-dialog">
        <div class="modal-content">

            <!-- Modal Header -->
            <div class="modal-header">
                <h4 class="modal-title">Details of Student</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <!-- Modal body -->
            <div class="modal-body" id="modalContent">
                Modal body..
            </div>

            <!-- Modal footer -->
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Close</button>
            </div>

        </div>
    </div>
</div>
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold text-primary">
            <i class="fa-solid fa-user-tie me-2"></i> Employee Management
        </h2>
        <a asp-controller="Administrative" asp-action="CreateEmployee" class="btn btn-success">
            <i class="fa-solid fa-user-plus"></i> Add Employee
        </a>
    </div>

    <form asp-action="List" method="get" class="row g-2 mb-4">
        <div class="col-md-3">
            <input type="text" name="name" class="form-control" placeholder="Search by name" />
        </div>
        <div class="col-md-3">
            <input type="text" name="phone" class="form-control" placeholder="Search by phone" />
        </div>
        <div class="col-md-1 d-grid">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-search"></i> Search
            </button>
        </div>
    </form>

    <table class="table table-bordered table-hover align-middle shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Employee ID</th>
                <th>Staff Code</th>
                <th>Employee Name</th>
                <th>Phone</th>
                <th>Job Title</th>
                <th>Hired Date</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.EmployeeId</td>
                        <td>@item.StaffCode</td>
                        <td>@item.EmployeeName</td>
                        <td>@item.Phone</td>
                        <td>@item.JobTitle</td>
                        <td>@item.HiredDate.ToShortDateString()</td>
                        <td>
                            <span class="badge bg-secondary">@item.Status</span>
                        </td>
                        <td>
                            <div class="mt-2">
                                <a asp-action="Edit" asp-route-id="@item.EmployeeId" class="btn btn-outline-success btn-sm me-1">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <a href="#" class="Details btn btn-outline-primary btn-sm" data-id="@item.EmployeeId">
                                    <i class="fa-solid fa-circle-info"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center text-muted">
                        <i class="fa-solid fa-info-circle"></i> No employees found.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@section Scripts{
    <script>
        $(document).ready(function (){
            $(".Details").click(function(){
                var id=$(this).attr("data-id");
                $.ajax({
                    url:"@Url.Action("Details", "Employee")",
                    type:"GET",
                    data:{"id":id},
                    dataType:"html",
                    success:function(data){
                        $("#modalContent").html(data),
                        $("#myModal").modal("show");

                    },
                    error:function(){
                        alert("Dynamic load failed");
                    },

                })
            });
        });
    </script>
}