@{
    ViewData["Title"] = "Home Page";
}

<div class="container mt-5">
    <div class="row align-items-center justify-content-center">
        <!-- Left section: Welcome text -->
        <div class="col-md-6 text-center text-md-start">
            <h1 class="display-4 fw-bold text-primary mb-3">Welcome to the Bank Management System</h1>
            <p class="lead text-secondary mb-4">
                Manage your customers, employees, and accounts efficiently through a secure and intuitive system.
                Register as a new customer or log in to your account to get started.
            </p>
            <div class="d-flex flex-column flex-md-row gap-3">
                <a asp-controller="Customer" asp-action="Register" class="btn btn-success btn-lg px-4">
                    <i class="bi bi-person-plus-fill me-2"></i> Register as Customer
                </a>
                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-primary btn-lg px-4">
                        <i class="bi bi-box-arrow-in-right me-2"></i> Go to Dashboard
                    </a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary btn-lg px-4">
                        <i class="bi bi-box-arrow-in-right me-2"></i> Login to Account
                    </a>
                }
            </div>
        </div>

        <!-- Right section: Illustration -->
        <div class="col-md-6 text-center mt-5 mt-md-0">
            <img src="https://cdn-icons-png.flaticon.com/512/3135/3135715.png"
                 alt="Bank Illustration" class="img-fluid" style="max-width: 80%; height: auto;">
        </div>
    </div>
</div>


