@model BankManagementSystem.Client.Dto.AccountRequest

@{
    ViewData["Title"] = "Request New Account";
}

<div class="container mt-4">
    <h3 class="fw-bold text-primary mb-4">Request a New Account</h3>

    <form id="accountForm">
        <div class="mb-3">
            <label class="form-label">Account Type</label>
            <select id="AccountTypeId" name="AccountTypeId" class="form-select" required>
                <option value="">-- Select Type --</option>
                <option value="1">Savings</option>
                <option value="2">Current</option>
                <option value="3">Fixed Deposit</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">Initial Deposit</label>
            <input type="number" id="InitialDeposit" name="InitialDeposit" class="form-control" required min="0" />
        </div>

        <button type="submit" class="btn btn-success w-100">Submit Request</button>
    </form>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {

            $("#AccountTypeId").on("change", function () {
                const selected = $(this).val();
                if (selected == "3") {
                    $("#InitialDeposit").val("3000").prop("readonly", true);
                } else {
                    $("#InitialDeposit").val("").prop("readonly", false);
                }
            });

            $("#accountForm").on("submit", function (e) {
                e.preventDefault();

                const data = {
                    AccountTypeId: parseInt($("#AccountTypeId").val()),
                    InitialDeposit: parseFloat($("#InitialDeposit").val())
                };

                $.ajax({
                    url: "/BankAccount/RequestAccount",
                    type: "POST",
                    contentType: "application/json",
                    data: JSON.stringify(data),
                    success: function (res) {
                        alert(res.message || "Account request submitted successfully!");
                        window.location.href = "/Dashboard/Index";
                    },
                    error: function (xhr) {
                        alert(xhr.responseText || "Error submitting request.");
                    }
                });
            });
        });
    </script>
}
