@model IEnumerable<BankManagementSystem.Client.Dto.AccountResponse>

@{
    ViewData["Title"] = "Account List";
}
<div class="modal" id="myModal">
    <div class="modal-dialog">
        <div class="modal-content">

            <!-- Modal Header -->
            <div class="modal-header">
                <h4 class="modal-title">Details of Student</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <!-- Modal body -->
            <div class="modal-body" id="modalContent">
                Modal body..
            </div>

            <!-- Modal footer -->
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Close</button>
            </div>

        </div>
    </div>
</div>
<div class="container mt-4">
    <h2 class="fw-bold text-primary mb-3">Account Management</h2>

    <form asp-action="List" asp-asp-controller="BankAccount" method="get" class="row g-2 mb-4">
        <div class="col-md-3">
            <input type="text" name="accountNumber" class="form-control" placeholder="Search by account number" />
        </div>
        <div class="col-md-1 d-grid">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-search"></i> Search
            </button>
        </div>
    </form>

    <table class="table table-bordered table-striped table-hover align-middle">
        <thead class="table-primary text-center">
            <tr>
                <th>Account Number</th>
                <th>Customer</th>
                <th>Account Type</th>
                <th>Balance</th>
                <th>Created Date</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr class="text-center">
                        <td>@item.AccountNumber</td>
                        <td>@item.CustomerName</td>
                        <td>@item.AccountTypeName</td>
                        <td>@item.Balance</td>
                        <td>@item.CreatedDate.ToString("dd-MM-yyyy")</td>
                        <td>
                            @if (item.Status == "Pending")
                            {
                                <span class="badge bg-warning text-dark">Pending</span>
                            }
                            else if (item.Status == "Active")
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@item.Status</span>
                            }
                        </td>
                        <td>
                            @if (item.Status == "Pending")
                            {
                                <form asp-controller="Administrative" asp-action="ApproveAccount" method="post" style="display:inline;">
                                    <input type="hidden" name="accountId" value="@item.AccountId" />
                                    <button type="submit" class="btn btn-sm btn-success">
                                        <i class="bi bi-check-circle me-1"></i> Approve
                                    </button>
                                </form>
                                <form asp-controller="Administrative" asp-action="RejectAccount" method="post" style="display:inline;">
                                    <input type="hidden" name="accountId" value="@item.AccountId" />
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        <i class="bi bi-x-circle me-1"></i> Reject
                                    </button>
                                </form>
                            }

                            <div class="mt-2">
                                <a asp-action="Edit" asp-route-id="@item.AccountId" class="btn btn-outline-success btn-sm me-1">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center text-muted">No accounts found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
