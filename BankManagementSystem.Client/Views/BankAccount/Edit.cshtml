@model BankManagementSystem.Client.Dto.AccountResponse
@{
    ViewData["Title"] = "Edit";
}

<div class="container mt-3 mb-3">
    <div class="row justify-content-center">
        <div class="col-lg-10 col-md-11">
            <div class="card shadow-lg border-0">
                <div class="card-header text-white text-center py-3" style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);">
                    <h3 class="mb-0"><i class="bi bi-credit-card-2-front me-2"></i>Edit Account Information</h3>
                    <small class="mb-0">Update account details and status</small>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        <input asp-for="AccountId" type="hidden" class="form-control" />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="AccountNumber" class="form-label fw-bold">
                                    <i class="bi bi-hash me-1"></i>Account Number
                                </label>
                                <input asp-for="AccountNumber" class="form-control" placeholder="Enter account number" />
                                <span asp-validation-for="AccountNumber" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="CustomerId" class="form-label fw-bold">
                                    <i class="bi bi-person-circle me-1"></i>Customer ID
                                </label>
                                <input asp-for="CustomerId" class="form-control" placeholder="Enter customer ID" />
                                <span asp-validation-for="CustomerId" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Balance" class="form-label fw-bold">
                                    <i class="bi bi-currency-dollar me-1"></i>Balance
                                </label>
                                <input asp-for="Balance" class="form-control" type="number" step="0.01" placeholder="Enter balance amount" />
                                <span asp-validation-for="Balance" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="CreatedDate" class="form-label fw-bold">
                                    <i class="bi bi-calendar-plus me-1"></i>Created Date
                                </label>
                                <input asp-for="CreatedDate" class="form-control" type="date" id="createdDateInput" />
                                <span asp-validation-for="CreatedDate" class="text-danger small"></span>
                            </div>

                            <div class="col-md-12">
                                <label asp-for="Status" class="form-label fw-bold">
                                    <i class="bi bi-toggle-on me-1"></i>Account Status
                                </label>
                                <select asp-for="Status" class="form-select" id="Status">
                                    <option value="">-- Select Status --</option>
                                    <option value="Pending">Pending</option>
                                    <option value="Approved">Approved</option>
                                    <option value="Rejected">Rejected</option>
                                </select>
                                <span asp-validation-for="Status" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <div class="d-grid gap-2 mt-2">
                                    <button type="submit" class="btn btn-custom btn-lg py-2">
                                        <i class="bi bi-save me-2"></i>Save Changes
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="card-footer bg-light text-center py-2">
                    <a asp-action="Index" class="text-decoration-none">
                        <i class="bi bi-arrow-left me-1"></i>Back to List
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {
            const today = new Date().toISOString().split('T')[0];
            $('#createdDateInput').attr('max', today);
        });
    </script>
}

<style>
    .card {
        border-radius: 12px;
        overflow: hidden;
    }

    .form-control:focus {
        border-color: #2a5298;
        box-shadow: 0 0 0 0.2rem rgba(42, 82, 152, 0.25);
    }

    .btn-custom {
        background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
        border: none;
        color: white;
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .btn-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(30, 60, 114, 0.4);
            color: white;
        }

    .form-label {
        color: #495057;
        margin-bottom: 0.3rem;
        font-size: 0.9rem;
    }

    .form-control {
        padding: 0.5rem 0.75rem;
    }

    .card-body {
        max-height: calc(100vh - 250px);
        overflow-y: auto;
    }
</style>