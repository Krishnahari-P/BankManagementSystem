<ul class="navbar-nav ms-auto align-items-center">
    @if (User.Identity.IsAuthenticated)
    {
        <li class="nav-item me-2">
            <a class="nav-link px-3 py-2 rounded text-white bg-primary fw-semibold"
               asp-area="" asp-controller="Home" asp-action="Index">
                Home
            </a>
        </li>
        <li class="nav-item me-2">
            <a class="nav-link px-3 py-2 rounded text-white bg-primary fw-semibold"
               asp-area="" asp-controller="Home" asp-action="Privacy">
                Privacy
            </a>
        </li>
        <li class="nav-item me-2">
            <a class="nav-link px-3 py-2 rounded text-white bg-success fw-semibold"
               asp-area="" asp-controller="Dashboard" asp-action="Index">
                Dashboard
            </a>
        </li>

        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
        {
            <li class="nav-item me-2">
                <a class="nav-link px-3 py-2 rounded text-white bg-info fw-semibold"
                   asp-controller="Customer" asp-action="Index">
                    Customers
                </a>
            </li>
            <li class="nav-item me-2">
                <a class="nav-link px-3 py-2 rounded text-white bg-info fw-semibold"
                   asp-controller="Employee" asp-action="Index">
                    Employees
                </a>
            </li>
            <li class="nav-item me-2">
                <a class="nav-link px-3 py-2 rounded text-white bg-info fw-semibold"
                   asp-controller="BankAccount" asp-action="Index">
                    Accounts
                </a>
            </li>
            <li class="nav-item me-2">
                <a class="nav-link px-3 py-2 rounded text-white bg-info fw-semibold"
                   asp-controller="Transaction" asp-action="Index">
                    Transactions
                </a>
            </li>
        }

        <li class="nav-item me-2">
            <a class="nav-link px-3 py-2 rounded text-dark bg-light border border-secondary fw-semibold"
               asp-area="" asp-controller="Account" asp-action="ChangePassword">
                Change Password
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link px-3 py-2 rounded text-white bg-danger fw-semibold"
               asp-area="" asp-controller="Account" asp-action="Logout">
                Log Out
            </a>
        </li>
    }
    else
    {
        <li class="nav-item me-2">
            <a class="nav-link px-3 py-2 rounded text-white bg-primary fw-semibold"
               asp-area="" asp-controller="Home" asp-action="Index">
                Home
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link px-3 py-2 rounded text-white bg-primary fw-semibold"
               asp-area="" asp-controller="Home" asp-action="Privacy">
                Privacy
            </a>
        </li>
    }
</ul>