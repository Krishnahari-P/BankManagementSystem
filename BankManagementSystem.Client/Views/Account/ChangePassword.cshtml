@model BankManagementSystem.Client.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card shadow-lg border-0">
                <div class="card-header text-white text-center py-3" style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);">
                    <h4 class="mb-0"><i class="fa-solid fa-lock me-2"></i>Change Password</h4>
                    <small class="mb-0">Update your account password</small>
                </div>
                <div class="card-body p-4">
                    <form asp-action="ChangePassword" method="post">
                        <div class="form-group mb-3">
                            <label class="form-label fw-semibold">
                                <i class="fa-solid fa-shield me-1"></i>Current Password
                            </label>
                            <input type="password" asp-for="OldPassword" class="form-control" placeholder="Enter current password" required />
                            <span asp-validation-for="OldPassword" class="text-danger small"></span>
                        </div>
                        <div class="form-group mb-3">
                            <label class="form-label fw-semibold">
                                <i class="fa-solid fa-key me-1"></i>New Password
                            </label>
                            <input type="password" asp-for="NewPassword" class="form-control" placeholder="Enter new password" required />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>
                        <div class="form-group mb-4">
                            <label class="form-label fw-semibold">
                                <i class="fa-solid fa-check-circle me-1"></i>Confirm Password
                            </label>
                            <input type="password" asp-for="ConfirmPassword" class="form-control" placeholder="Confirm new password" required />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                        <button type="submit" class="btn btn-custom w-100 py-2">
                            <i class="fa-solid fa-key me-2"></i> Change Password
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<style>
    .card {
        border-radius: 12px;
        overflow: hidden;
    }

    .form-control:focus {
        border-color: #2a5298;
        box-shadow: 0 0 0 0.2rem rgba(42, 82, 152, 0.25);
    }

    .btn-custom {
        background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
        border: none;
        color: white;
        font-weight: 600;
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .btn-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(30, 60, 114, 0.4);
            color: white;
        }

    .form-label {
        color: #495057;
        margin-bottom: 0.5rem;
        font-size: 0.95rem;
    }

    .form-control {
        padding: 0.6rem 0.75rem;
    }
</style>