@model IEnumerable<BankManagementSystem.Client.Dto.AccountTypeResponse>

@{
    ViewData["Title"] = "Account Types";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary">
            <i class="fa-solid fa-layer-group me-2"></i> Account Types
        </h2>
        <a asp-action="Create" class="btn btn-success shadow-sm">
            <i class="fa-solid fa-plus"></i> Add New Account Type
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-primary">
                    <tr class="text-center">
                        <th>Type Name</th>
                        <th>Description</th>
                        <th>Interest Rate (%)</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr class="text-center">
                                <td>
                                    <span class="fw-semibold text-primary">
                                        <i class="fa-solid fa-file-invoice-dollar me-1 text-secondary"></i>
                                        @item.TypeName
                                    </span>
                                </td>
                                <td>@item.Description</td>
                                <td>
                                    <span class="badge bg-info text-dark">
                                        @item.InterestRate.ToString("0.00")%
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex justify-content-center gap-2">
                                        <a asp-action="Edit" asp-route-id="@item.AccountTypeId"
                                           class="btn btn-outline-primary btn-sm">
                                            <i class="fa-solid fa-pen-to-square"></i> Edit
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.AccountTypeId"
                                           class="btn btn-outline-info btn-sm">
                                            <i class="fa-solid fa-circle-info"></i> Details
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                <i class="fa-solid fa-circle-exclamation me-2"></i> No account types found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
