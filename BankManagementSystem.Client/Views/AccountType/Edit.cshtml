@model BankManagementSystem.Client.Dto.AccountTypeResponse
@{
    ViewData["Title"] = "Edit";
}

<div class="container mt-3 mb-3">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card shadow-lg border-0">
                <div class="card-header text-white text-center py-3" style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);">
                    <h3 class="mb-0"><i class="bi bi-bank me-2"></i>Edit Account Type</h3>
                    <small class="mb-0">Update account type details and interest rate</small>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        <input asp-for="AccountTypeId" type="hidden" class="form-control" />

                        <div class="row g-3">
                            <div class="col-md-12">
                                <label asp-for="TypeName" class="form-label fw-bold">
                                    <i class="bi bi-tag me-1"></i>Account Type Name
                                </label>
                                <input asp-for="TypeName" class="form-control" placeholder="e.g., Savings, Current, Fixed Deposit" />
                                <span asp-validation-for="TypeName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-12">
                                <label asp-for="Description" class="form-label fw-bold">
                                    <i class="bi bi-file-text me-1"></i>Description
                                </label>
                                <input asp-for="Description" class="form-control" placeholder="Enter account type description" />
                                <span asp-validation-for="Description" class="text-danger small"></span>
                            </div>

                            <div class="col-md-12">
                                <label asp-for="InterestRate" class="form-label fw-bold">
                                    <i class="bi bi-percent me-1"></i>Interest Rate (%)
                                </label>
                                <input asp-for="InterestRate" class="form-control" type="number" min="0" max="9" step="0.01" placeholder="Enter interest rate" />
                                <span asp-validation-for="InterestRate" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <div class="d-grid gap-2 mt-2">
                                    <button type="submit" class="btn btn-custom btn-lg py-2">
                                        <i class="bi bi-save me-2"></i>Save Changes
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="card-footer bg-light text-center py-2">
                    <a asp-action="Index" class="text-decoration-none">
                        <i class="bi bi-arrow-left me-1"></i>Back to List
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

<style>
    .card {
        border-radius: 12px;
        overflow: hidden;
    }

    .form-control:focus {
        border-color: #2a5298;
        box-shadow: 0 0 0 0.2rem rgba(42, 82, 152, 0.25);
    }

    .btn-custom {
        background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
        border: none;
        color: white;
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .btn-custom:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(30, 60, 114, 0.4);
        color: white;
    }

    .form-label {
        color: #495057;
        margin-bottom: 0.3rem;
        font-size: 0.9rem;
    }

    .form-control {
        padding: 0.5rem 0.75rem;
    }

    .card-body {
        max-height: calc(100vh - 250px);
        overflow-y: auto;
    }
</style>