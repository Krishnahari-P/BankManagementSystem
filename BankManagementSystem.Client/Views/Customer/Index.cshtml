@model IEnumerable<BankManagementSystem.Client.Dto.CustomerResponse>

@{
    ViewData["Title"] = "Customer List";
}

<div class="modal" id="myModal">
    <div class="modal-dialog">
        <div class="modal-content">

            <!-- Modal Header -->
            <div class="modal-header">
                <h4 class="modal-title">Details of Student</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <!-- Modal body -->
            <div class="modal-body" id="modalContent">
                Modal body..
            </div>

            <!-- Modal footer -->
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Close</button>
            </div>

        </div>
    </div>
</div>

<div class="container mt-4">
    <h2 class="fw-bold text-primary mb-3">Customer Management</h2>

    <form asp-action="List" method="get" class="row g-2 mb-4">
        <div class="col-md-3">
            <input type="text" name="customerName" class="form-control" placeholder="Search by Name" />
        </div>
        <div class="col-md-3">
            <input type="text" name="aadhar" class="form-control" placeholder="Search by Aadhar" />
        </div>      
        <div class="col-md-2">
            <select name="status" class="form-select">
                <option value="">-- Status --</option>
                <option value="Pending">Pending</option>
                <option value="Approved">Approved</option>
                <option value="Rejected">Rejected</option>
            </select>
        </div>
        <div class="col-md-3">
            <input type="text" name="phone" class="form-control" placeholder="Search by Phone" />
        </div>
        <div class="col-md-1 d-grid">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-search"></i> Search
            </button>
        </div>
    </form>
    <table class="table table-bordered table-striped table-hover align-middle">
        <thead class="table-primary text-center">
            <tr>
                <th>Customer Id</th>
                <th>Customer Name</th>
                <th class="text-nowrap">DOB</th>
                <th>Occupation</th>
                <th>Phone</th>
                <th>Aadhar</th>
                <th>PAN</th>
                <th>Status</th>
                <th>Approval Date</th>
                <th>Approved by</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.CustomerId</td>
                        <td>@item.CustomerName</td>
                        <td class="text-nowrap">@item.DateOfBirth?.ToString("dd-MM-yyyy")</td>
                        <td>@item.Occupation</td>
                        <td>@item.Phone</td>
                        <td>@item.AadharNumber</td>
                        <td>@item.PAN</td>
                        <td>
                            @if (item.Status == "Pending")
                            {
                                <span class="badge bg-warning text-dark">Pending</span>
                            }
                            else if (item.Status == "Approved")
                            {
                                <span class="badge bg-success">Approved</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@item.Status</span>
                            }
                        </td>
                        <td class="text-nowrap">@(item.ApprovalDate?.ToString("dd-MM-yyyy") ?? "-")</td>
                        <td>@(item.ApprovedByName ?? "—")</td>
                        <td>
                            @if (item.Status == "Pending")
                            {
                                <form class="approve-form" data-id="@item.CustomerId" style="display:inline;">
                                    <button type="submit" class="btn btn-sm btn-success">
                                        <i class="bi bi-check-circle me-1"></i> Approve
                                    </button>
                                </form>
                                <form class="reject-form" data-id="@item.CustomerId" style="display:inline;">
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        <i class="bi bi-x-circle me-1"></i> Reject
                                    </button>
                                </form>

                            }           
                            <div class="mt-2">
                                <a asp-action="Edit" asp-route-id="@item.CustomerId" class="btn btn-outline-success btn-sm me-1">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <a href="#" class="Details btn btn-outline-primary btn-sm" data-id="@item.CustomerId">
                                    <i class="fa-solid fa-circle-info"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="9" class="text-center text-muted">No customers found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
@section Scripts {
    <script>
        $(document).ready(function () {
            $(".approve-form").on("submit", function (e) {
                e.preventDefault();
                var customerId = $(this).data("id");

                $.ajax({
                    url: `/Administrative/ApproveCustomer?id=${customerId}`,
                    type: "POST",
                    success: function (data) {
                        $("#myModal .modal-title").text("Customer Account Created");
                        $("#modalContent").html(`
                            <p><strong>Username:</strong> ${data.userName}</p>
                            <p><strong>Temporary Password:</strong> ${data.temporaryPassword}</p>
                            <p class="text-success fw-bold">Please note these credentials for customer login.</p>
                        `);
                        $("#myModal").on("hidden.bs.modal", function () {
                            location.reload();
                        });
                        $("#myModal").modal("show");
                    },
                    error: function () {
                        $("#myModal .modal-title").text("Error");
                        $("#modalContent").html(`
                            <p class="text-danger">Error approving customer or creating account.</p>
                        `);
                        $("#myModal").modal("show");
                    }
                });
            });

            $(".reject-form").on("submit", function (e) {
                e.preventDefault();
                var customerId = $(this).data("id");

                if (!confirm("Are you sure you want to reject this customer?")) return;

                $.ajax({
                    url: `/Administrative/RejectCustomer?id=${customerId}`,
                    type: "POST",
                    success: function () {
                        $("#myModal .modal-title").text("Customer Rejected");
                        $("#modalContent").html(`
                            <p class="text-danger fw-bold">Customer has been rejected successfully.</p>
                        `);
                        $("#myModal").on("hidden.bs.modal", function () {
                            location.reload();
                        });
                        $("#myModal").modal("show");
                    },
                    error: function () {
                        $("#myModal .modal-title").text("Error");
                        $("#modalContent").html(`
                            <p class="text-danger">Error rejecting customer.</p>
                        `);
                        $("#myModal").modal("show");
                    }
                });
            });
            $(".Details").click(function(){
                var id=$(this).attr("data-id");
                $.ajax({
                    url:"@Url.Action("Details", "Customer")",
                    type:"GET",
                    data:{"id":id},
                    dataType:"html",
                    success:function(data){
                        $("#modalContent").html(data),
                        $("#myModal").modal("show");

                    },
                    error:function(){
                        alert("Dynamic load failed");
                    },

                })
            });

        });
    </script>
}



