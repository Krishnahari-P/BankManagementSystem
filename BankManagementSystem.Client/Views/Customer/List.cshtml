@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/datatables/js/jquery.datatables.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#customerTable').DataTable({
                "ajax": {
                    "url": '@Url.Action("ListJson", "Customer")',
                    "type": "GET",
                    "datatype": "json"
                },
                "columns": [
                    { "data": "customerName", "autoWidth": true },
                    { "data": "dateOfBirth", "autoWidth": true },
                    { "data": "occupation", "autoWidth": true },
                    { "data": "phone", "autoWidth": true },
                    { "data": "approvedByUserId", "autoWidth": true },
                    { "data": "approvalDate", "autoWidth": true },
                    { "data": "aadharNumber", "autoWidth": true },
                    { "data": "pan", "autoWidth": true },
                    { "data": "status", "autoWidth": true },
                    {
                        "data": "customerId",
                        "render": function (data, type, row) {
                            return `
                                <a href="/Customer/Edit/${data}" class="btn btn-sm btn-outline-success">Edit</a>
                                <button class="btn btn-sm btn-outline-primary" onclick="Details(${data})">Details</button>
                                <a href="/Customer/Delete/${data}" class="btn btn-sm btn-outline-danger">Delete</a>
                            `;
                        }
                    }
                ]
            });
        });

        function Details(id) {
            $.ajax({
                url: "@Url.Action("Details", "Customer")",
                type: "GET",
                data: { id: id },
                dataType: "html",
                success: function (data) {
                    $("#modalContent").html(data);
                    $("#myModal").modal("show");
                },
                error: function () {
                    alert("Failed to load details.");
                }
            });
        }
    </script>
}

