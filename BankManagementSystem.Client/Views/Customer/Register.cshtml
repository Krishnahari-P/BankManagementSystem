@model BankManagementSystem.Client.ViewModels.CustomerRegistrationViewModel
@{
    ViewData["Title"] = "Register";
}

<div class="container mt-3 mb-3">
    <div class="row justify-content-center">
        <div class="col-lg-10 col-md-11">
            <div class="card shadow-lg border-0">
                <div class="card-header text-white text-center py-3" style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);">
                    <h3 class="mb-0"><i class="bi bi-person-plus-fill me-2"></i>Customer Registration</h3>
                    <small class="mb-0">Please fill in your details to open an account</small>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Register">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="CustomerName" class="form-label fw-bold">
                                    <i class="bi bi-person me-1"></i>Full Name
                                </label>
                                <input asp-for="CustomerName" class="form-control" placeholder="Enter your full name" />
                                <span asp-validation-for="CustomerName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="DateOfBirth" class="form-label fw-bold">
                                    <i class="bi bi-calendar-event me-1"></i>Date of Birth
                                </label>
                                <input asp-for="DateOfBirth" class="form-control" type="date" id="dobInput" />
                                <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Occupation" class="form-label fw-bold">
                                    <i class="bi bi-briefcase me-1"></i>Occupation
                                </label>
                                <input asp-for="Occupation" class="form-control" placeholder="Enter your occupation" />
                                <span asp-validation-for="Occupation" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label fw-bold">
                                    <i class="bi bi-telephone me-1"></i>Phone Number
                                </label>
                                <input asp-for="Phone" class="form-control" placeholder="Enter your phone number" />
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="AadharNumber" class="form-label fw-bold">
                                    <i class="bi bi-card-text me-1"></i>Aadhar Number
                                </label>
                                <input asp-for="AadharNumber" class="form-control" placeholder="Enter 12-digit Aadhar" />
                                <span asp-validation-for="AadharNumber" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="PAN" class="form-label fw-bold">
                                    <i class="bi bi-credit-card me-1"></i>PAN Number
                                </label>
                                <input asp-for="PAN" class="form-control" placeholder="Enter PAN number" style="text-transform: uppercase;" />
                                <span asp-validation-for="PAN" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <div class="d-grid gap-2 mt-2">
                                    <button type="submit" class="btn btn-custom btn-lg py-2">
                                        <i class="bi bi-check-circle me-2"></i>Submit Registration
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="card-footer bg-light text-center py-2">
                    <a asp-action="Index" asp-controller="Home" class="text-decoration-none">
                        <i class="bi bi-arrow-left me-1"></i>Back to List
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {
            const today = new Date().toISOString().split('T')[0];
            $('#dobInput').attr('max', today);
        });
    </script>
}

<style>
    .card {
        border-radius: 12px;
        overflow: hidden;
    }

    .form-control:focus {
        border-color: #2a5298;
        box-shadow: 0 0 0 0.2rem rgba(42, 82, 152, 0.25);
    }

    .btn-custom {
        background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
        border: none;
        color: white;
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .btn-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(30, 60, 114, 0.4);
            color: white;
        }

    .form-label {
        color: #495057;
        margin-bottom: 0.3rem;
        font-size: 0.9rem;
    }

    .form-control {
        padding: 0.5rem 0.75rem;
    }

    .card-body {
        max-height: calc(100vh - 250px);
        overflow-y: auto;
    }
</style>