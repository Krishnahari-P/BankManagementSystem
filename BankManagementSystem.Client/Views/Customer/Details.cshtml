@model BankManagementSystem.Client.Dto.CustomerResponse
@{
    ViewData["Title"] = "Details";
    Layout = "_DetailsLayout";
}

<div class="container mt-3 mb-3">
    <div class="row justify-content-center">
        <div class="col-lg-11 col-md-12">
            <div class="card shadow-lg border-0">
                <div class="card-header text-white py-2" style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="bi bi-person-circle me-2"></i>Customer Details</h5>
                    </div>
                </div>
                <div class="card-body p-3">
                    <div class="row g-2">
                        <div class="col-md-4">
                            <div class="detail-box">
                                <small class="text-muted d-block mb-1">
                                    <i class="bi bi-person me-1"></i>@Html.DisplayNameFor(model => model.CustomerName)
                                </small>
                                <strong>@Html.DisplayFor(model => model.CustomerName)</strong>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="detail-box">
                                <small class="text-muted d-block mb-1">
                                    <i class="bi bi-check-circle me-1"></i>@Html.DisplayNameFor(model => model.Status)
                                </small>
                                <strong>@Html.DisplayFor(model => model.Status)</strong>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="detail-box">
                                <small class="text-muted d-block mb-1">
                                    <i class="bi bi-briefcase me-1"></i>@Html.DisplayNameFor(model => model.Occupation)
                                </small>
                                <strong>@Html.DisplayFor(model => model.Occupation)</strong>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="detail-box">
                                <small class="text-muted d-block mb-1">
                                    <i class="bi bi-telephone me-1"></i>@Html.DisplayNameFor(model => model.Phone)
                                </small>
                                <strong>@Html.DisplayFor(model => model.Phone)</strong>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="detail-box">
                                <small class="text-muted d-block mb-1">
                                    <i class="bi bi-card-text me-1"></i>@Html.DisplayNameFor(model => model.AadharNumber)
                                </small>
                                <strong>@Html.DisplayFor(model => model.AadharNumber)</strong>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="detail-box">
                                <small class="text-muted d-block mb-1">
                                    <i class="bi bi-credit-card me-1"></i>@Html.DisplayNameFor(model => model.PAN)
                                </small>
                                <strong>@Html.DisplayFor(model => model.PAN)</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    dl.row {
        display: flex;
        flex-wrap: wrap;
    }

        dl.row dt {
            flex: 0 0 25% !important;
            font-weight: 600;
            text-align: right;
            padding-right: 10px;
            align-self: center;
        }

        dl.row dd {
            flex: 0 0 70% !important;
            margin: 0 !important;
            align-self: center;
            word-break: break-word;
        }

    .card {
        border-radius: 12px;
        overflow: hidden;
    }

    .detail-box {
        background: #f8f9fa;
        padding: 0.6rem 0.9rem;
        border-radius: 8px;
        border-left: 3px solid #2a5298;
        height: 100%;
        min-width: 0;
    }

        .detail-box strong {
            color: #333;
            font-size: 0.95rem;
            display: block;
        }

        .detail-box small {
            font-size: 0.8rem;
        }

    .btn-light:hover {
        background-color: #fff;
        transform: translateY(-1px);
    }
</style>