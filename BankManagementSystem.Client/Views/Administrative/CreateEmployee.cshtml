@model BankManagementSystem.Client.Dto.EmployeeRequest

@{
    ViewData["Title"] = "Add New Employee";
}

<div class="container mt-5">
    <div class="card shadow border-0">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">
                <i class="fa-solid fa-user-plus me-2"></i> Add New Employee
            </h4>
        </div>
        <div class="card-body">
            <form asp-action="CreateEmployee" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="EmployeeName" class="form-label fw-semibold"></label>
                    <input asp-for="EmployeeName" class="form-control" placeholder="Enter employee name" required />
                    <span asp-validation-for="EmployeeName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Phone" class="form-label fw-semibold"></label>
                    <input asp-for="Phone" class="form-control" placeholder="Enter phone number" maxlength="10" required />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="JobTitle" class="form-label fw-semibold"></label>
                    <select asp-for="JobTitle" class="form-select" required>
                        <option value="">-- Select Job Title --</option>
                        <option value="Manager">Manager</option>
                    </select>
                    <span asp-validation-for="JobTitle" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-controller="Employee" asp-action="Index" class="btn btn-secondary">
                        <i class="fa-solid fa-arrow-left"></i> Back to List
                    </a>
                    <button type="submit" class="btn btn-success">
                        <i class="fa-solid fa-user-check"></i> Create Employee
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
