@model IEnumerable<BankManagementSystem.Client.Dto.AccountResponse>

@{
    ViewData["Title"] = "Transfer Money";
}

<div class="container mt-4">
    <h2 class="fw-bold text-primary mb-4">Transfer Funds</h2>

    <form asp-action="Transfer" method="post" class="card p-4 shadow-sm border-0" id="transferForm">
        <div class="form-group mb-3">
            <label class="form-label fw-semibold">From Account</label>
            <select class="form-select" name="SenderAccountId" id="senderAccount" required>
                <option value="">-- Select Sender Account --</option>
                @foreach (var acc in Model)
                {
                    if (acc.Status == "Pending")
                    {
                        continue;
                    }
                    string typeName = acc.AccountTypeId switch
                    {
                        1 => "Savings",
                        2 => "Current",
                        3 => "Fixed Deposit",
                        _ => "Unknown"
                    };

                    <option value="@acc.AccountId" data-balance="@acc.Balance">
                        @(acc.AccountNumber ?? "N/A") (@typeName) -
                        <i class="fa-solid fa-indian-rupee-sign"></i> @(acc.Balance.ToString("0.00"))
                    </option>
                }
            </select>
        </div>

        <div class="form-group mb-3">
            <label class="form-label fw-semibold">Recipient Account Number</label>
            <input type="text" name="RecipientAccountNumber" id="recipientAccountNumber"
                   class="form-control" placeholder="Enter recipient account number" required />
        </div>

        <div class="form-group mb-3">
            <label class="form-label fw-semibold">Amount</label>
            <input type="number" step="0.01" name="Amount" id="amount"
                   class="form-control" placeholder="Enter transfer amount" required />
        </div>

        <div class="form-group mb-3">
            <label class="form-label fw-semibold">Description</label>
            <input type="text" name="Description" class="form-control" placeholder="Optional note" />
        </div>

        <button type="submit" class="btn btn-primary w-100">
            <i class="bi bi-arrow-left-right"></i> Submit Transfer
        </button>
    </form>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $("#transferForm").on("submit", function (e) {
                const sender = $("#senderAccount option:selected");
                const balance = parseFloat(sender.data("balance") || 0);
                const amount = parseFloat($("#amount").val() || 0);
                const recipient = $("#recipientAccountNumber").val().trim();

                if (!sender.val()) {
                    alert("Please select a sender account.");
                    e.preventDefault();
                    return;
                }

                if (!recipient) {
                    alert("Please enter recipient account number.");
                    e.preventDefault();
                    return;
                }

                if (isNaN(amount) || amount <= 0) {
                    alert("Transfer amount must be greater than 0.");
                    e.preventDefault();
                    return;
                }

                if (amount > balance) {
                    alert("Insufficient balance in the selected account.");
                    e.preventDefault();
                    return;
                }
            });
        });
    </script>
}
