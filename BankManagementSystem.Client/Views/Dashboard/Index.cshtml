@model BankManagementSystem.Client.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}
@if (User.IsInRole("Admin") || User.IsInRole("Manager"))
{
    <div class="container-fluid mt-4">
        <div class="row">
            <!-- Sidebar -->
            <nav class="col-md-3 col-lg-2 d-md-block bg-white shadow-sm border-end min-vh-100">
                <div class="p-3">
                    <h5 class="fw-bold text-primary mb-3 pb-2 border-bottom">
                        <i class="bi bi-speedometer2 me-2"></i>Navigation
                    </h5>
                    <div class="nav flex-column gap-2">
                        <a class="btn btn-outline-primary text-start w-100 d-flex align-items-center py-2 px-3" asp-controller="Customer" asp-action="Index">
                            <i class="bi bi-people me-2 flex-shrink-0"></i>
                            <span class="text-truncate">Customers</span>
                        </a>
                        <a class="btn btn-outline-primary text-start w-100 d-flex align-items-center py-2 px-3" asp-controller="Employee" asp-action="Index">
                            <i class="bi bi-person-badge me-2 flex-shrink-0"></i>
                            <span class="text-truncate">Employees</span>
                        </a>
                        <a class="btn btn-outline-primary text-start w-100 d-flex align-items-center py-2 px-3" asp-controller="BankAccount" asp-action="Index">
                            <i class="bi bi-wallet2 me-2 flex-shrink-0"></i>
                            <span class="text-truncate">Accounts</span>
                        </a>
                        <a class="btn btn-outline-primary text-start w-100 d-flex align-items-center py-2 px-3" asp-controller="AccountType" asp-action="Index">
                            <i class="bi bi-diagram-3 me-2 flex-shrink-0"></i>
                            <span class="text-truncate">Account Types</span>
                        </a>
                        <a class="btn btn-outline-primary text-start w-100 d-flex align-items-center py-2 px-3" asp-controller="Transaction" asp-action="Index">
                            <i class="bi bi-arrow-left-right me-2 flex-shrink-0"></i>
                            <span class="text-truncate">Transactions</span>
                        </a>
                    </div>
                </div>
            </nav>

            <!-- Main content -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 bg-light">
                <div class="pt-4 pb-3 mb-4">
                    <h2 class="fw-bold text-dark mb-1">Bank Management Dashboard</h2>
                    <p class="text-muted mb-0">System Overview & Statistics</p>
                </div>

                <!-- Statistics Cards -->
                <div class="row g-4 mb-4">
                    <div class="col-md-6 col-lg-4">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div>
                                        <h6 class="text-muted mb-1 fw-normal">Total Customers</h6>
                                        <h2 class="fw-bold text-primary mb-0">@Model.TotalCustomers</h2>
                                    </div>
                                    <div class="bg-primary bg-opacity-10 rounded-3 p-3">
                                        <i class="bi bi-people fs-3 text-primary"></i>
                                    </div>
                                </div>
                                <small class="text-success"><i class="bi bi-arrow-up"></i> Active accounts</small>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div>
                                        <h6 class="text-muted mb-1 fw-normal">Total Employees</h6>
                                        <h2 class="fw-bold text-success mb-0">@Model.TotalEmployees</h2>
                                    </div>
                                    <div class="bg-success bg-opacity-10 rounded-3 p-3">
                                        <i class="bi bi-person-badge fs-3 text-success"></i>
                                    </div>
                                </div>
                                <small class="text-muted"><i class="bi bi-check-circle"></i> Staff members</small>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div>
                                        <h6 class="text-muted mb-1 fw-normal">Bank Accounts</h6>
                                        <h2 class="fw-bold text-info mb-0">@Model.TotalAccounts</h2>
                                    </div>
                                    <div class="bg-info bg-opacity-10 rounded-3 p-3">
                                        <i class="bi bi-wallet2 fs-3 text-info"></i>
                                    </div>
                                </div>
                                <small class="text-muted"><i class="bi bi-bank"></i> Active accounts</small>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div>
                                        <h6 class="text-muted mb-1 fw-normal">Account Types</h6>
                                        <h2 class="fw-bold text-warning mb-0">@Model.TotalAccountTypes</h2>
                                    </div>
                                    <div class="bg-warning bg-opacity-10 rounded-3 p-3">
                                        <i class="bi bi-diagram-3 fs-3 text-warning"></i>
                                    </div>
                                </div>
                                <small class="text-muted"><i class="bi bi-list-ul"></i> Available types</small>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div>
                                        <h6 class="text-muted mb-1 fw-normal">Total Transactions</h6>
                                        <h2 class="fw-bold text-danger mb-0">@Model.TotalTransactions</h2>
                                    </div>
                                    <div class="bg-danger bg-opacity-10 rounded-3 p-3">
                                        <i class="bi bi-arrow-left-right fs-3 text-danger"></i>
                                    </div>
                                </div>
                                <small class="text-muted"><i class="bi bi-cash-stack"></i> Transactions processed</small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Summary Table -->
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-bottom py-3">
                        <h5 class="mb-0 fw-bold text-dark">System Summary</h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light">
                                    <tr>
                                        <th class="py-3 ps-4 fw-semibold">Statistic</th>
                                        <th class="py-3 text-center fw-semibold">Count</th>
                                        <th class="py-3 pe-4 text-end fw-semibold">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td class="ps-4 py-3">
                                            <i class="bi bi-people text-primary me-2"></i>
                                            <span class="fw-semibold">Total Customers</span>
                                        </td>
                                        <td class="text-center py-3">
                                            <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2">@Model.TotalCustomers</span>
                                        </td>
                                        <td class="pe-4 text-end py-3">
                                            <span class="badge bg-success">Active</span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="ps-4 py-3">
                                            <i class="bi bi-person-badge text-success me-2"></i>
                                            <span class="fw-semibold">Total Employees</span>
                                        </td>
                                        <td class="text-center py-3">
                                            <span class="badge bg-success bg-opacity-10 text-success px-3 py-2">@Model.TotalEmployees</span>
                                        </td>
                                        <td class="pe-4 text-end py-3">
                                            <span class="badge bg-success">Active</span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="ps-4 py-3">
                                            <i class="bi bi-wallet2 text-info me-2"></i>
                                            <span class="fw-semibold">Total Accounts</span>
                                        </td>
                                        <td class="text-center py-3">
                                            <span class="badge bg-info bg-opacity-10 text-info px-3 py-2">@Model.TotalAccounts</span>
                                        </td>
                                        <td class="pe-4 text-end py-3">
                                            <span class="badge bg-success">Active</span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="ps-4 py-3">
                                            <i class="bi bi-diagram-3 text-warning me-2"></i>
                                            <span class="fw-semibold">Total Account Types</span>
                                        </td>
                                        <td class="text-center py-3">
                                            <span class="badge bg-warning bg-opacity-10 text-warning px-3 py-2">@Model.TotalAccountTypes</span>
                                        </td>
                                        <td class="pe-4 text-end py-3">
                                            <span class="badge bg-success">Active</span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="ps-4 py-3">
                                            <i class="bi bi-arrow-left-right text-danger me-2"></i>
                                            <span class="fw-semibold">Total Transactions</span>
                                        </td>
                                        <td class="text-center py-3">
                                            <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-2">@Model.TotalTransactions</span>
                                        </td>
                                        <td class="pe-4 text-end py-3">
                                            <span class="badge bg-success">Processed</span>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>
}

@if (User.IsInRole("Customer"))
{
    <div class="container-fluid mt-4">
        <div class="row">
            <!-- Sidebar -->
            <nav class="col-md-3 col-lg-2 d-md-block bg-white shadow-sm border-end min-vh-100">
                <div class="p-3">
                    <h5 class="fw-bold text-primary mb-3 pb-2 border-bottom">
                        <i class="bi bi-credit-card me-2"></i>Quick Actions
                    </h5>
                    <div class="nav flex-column gap-2">
                        <a class="btn btn-primary text-start w-100 d-flex align-items-center py-2 px-3" asp-controller="BankAccount" asp-action="Create">
                            <i class="bi bi-plus-circle me-2 flex-shrink-0"></i>
                            <span class="text-truncate">Create Account</span>
                        </a>
                        <a class="btn btn-outline-success text-start w-100 d-flex align-items-center py-2 px-3" asp-controller="Transaction" asp-action="Deposit">
                            <i class="bi bi-arrow-down-circle me-2 flex-shrink-0"></i>
                            <span class="text-truncate">Deposit Amount</span>
                        </a>
                        <a class="btn btn-outline-warning text-start w-100 d-flex align-items-center py-2 px-3" asp-controller="Transaction" asp-action="Withdraw">
                            <i class="bi bi-arrow-up-circle me-2 flex-shrink-0"></i>
                            <span class="text-truncate">Withdraw Amount</span>
                        </a>
                        <a class="btn btn-outline-info text-start w-100 d-flex align-items-center py-2 px-3" asp-controller="Transaction" asp-action="Transfer">
                            <i class="bi bi-arrow-left-right me-2 flex-shrink-0"></i>
                            <span class="text-truncate">Account Transfer</span>
                        </a>
                    </div>
                </div>
            </nav>

            <!-- Main content -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 bg-light">
                <div class="pt-4 pb-3 mb-4">
                    <h2 class="fw-bold text-dark mb-1">Customer Dashboard</h2>
                    <p class="text-muted mb-0">Welcome back! Manage your accounts and transactions</p>
                </div>

                <!-- Quick Stats -->
                <div class="row g-4 mb-4">
                    <div class="col-md-6 col-lg-3">
                        <div class="card border-0 shadow-sm text-center h-100">
                            <div class="card-body py-4">
                                <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex p-3 mb-3">
                                    <i class="bi bi-wallet2 fs-2 text-primary"></i>
                                </div>
                                <h6 class="text-muted mb-2">My Accounts</h6>
                                <h3 class="fw-bold text-primary mb-0">View</h3>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6 col-lg-3">
                        <div class="card border-0 shadow-sm text-center h-100">
                            <div class="card-body py-4">
                                <div class="bg-success bg-opacity-10 rounded-circle d-inline-flex p-3 mb-3">
                                    <i class="bi bi-arrow-down-circle fs-2 text-success"></i>
                                </div>
                                <h6 class="text-muted mb-2">Deposit</h6>
                                <h3 class="fw-bold text-success mb-0">Add Funds</h3>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6 col-lg-3">
                        <div class="card border-0 shadow-sm text-center h-100">
                            <div class="card-body py-4">
                                <div class="bg-warning bg-opacity-10 rounded-circle d-inline-flex p-3 mb-3">
                                    <i class="bi bi-arrow-up-circle fs-2 text-warning"></i>
                                </div>
                                <h6 class="text-muted mb-2">Withdraw</h6>
                                <h3 class="fw-bold text-warning mb-0">Get Cash</h3>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6 col-lg-3">
                        <div class="card border-0 shadow-sm text-center h-100">
                            <div class="card-body py-4">
                                <div class="bg-info bg-opacity-10 rounded-circle d-inline-flex p-3 mb-3">
                                    <i class="bi bi-arrow-left-right fs-2 text-info"></i>
                                </div>
                                <h6 class="text-muted mb-2">Transfer</h6>
                                <h3 class="fw-bold text-info mb-0">Send Money</h3>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Welcome Card -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body p-5 text-center">
                        <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex p-4 mb-3">
                            <i class="bi bi-bank fs-1 text-primary"></i>
                        </div>
                        <h4 class="fw-bold mb-3">Welcome to Your Banking Portal</h4>
                        <p class="text-muted mb-4">Manage your accounts, make transactions, and monitor your financial activities all in one place.</p>
                        <div class="d-flex gap-3 justify-content-center flex-wrap">
                            <a class="btn btn-primary px-4" asp-controller="BankAccount" asp-action="Create">
                                <i class="bi bi-plus-circle me-2"></i>Open New Account
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Info Cards -->
                <div class="row g-4">
                    <div class="col-md-4">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body p-4">
                                <div class="d-flex align-items-center mb-3">
                                    <div class="bg-success bg-opacity-10 rounded-3 p-2 me-3">
                                        <i class="bi bi-shield-check fs-4 text-success"></i>
                                    </div>
                                    <h6 class="mb-0 fw-bold">Secure Banking</h6>
                                </div>
                                <p class="text-muted small mb-0">Your transactions are protected with bank-level security</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body p-4">
                                <div class="d-flex align-items-center mb-3">
                                    <div class="bg-info bg-opacity-10 rounded-3 p-2 me-3">
                                        <i class="bi bi-lightning-charge fs-4 text-info"></i>
                                    </div>
                                    <h6 class="mb-0 fw-bold">Instant Transfers</h6>
                                </div>
                                <p class="text-muted small mb-0">Transfer money instantly between accounts</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body p-4">
                                <div class="d-flex align-items-center mb-3">
                                    <div class="bg-warning bg-opacity-10 rounded-3 p-2 me-3">
                                        <i class="bi bi-headset fs-4 text-warning"></i>
                                    </div>
                                    <h6 class="mb-0 fw-bold">24/7 Support</h6>
                                </div>
                                <p class="text-muted small mb-0">Our team is always here to help you</p>
                            </div>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>
    <hr />
    //Transactions
    @if (Model.Transactions != null && Model.Transactions.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="fa-solid fa-money-bill-transfer me-2"></i>Recent Transactions</h5>
                <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#transactionHistory" aria-expanded="false" aria-controls="transactionHistory">
                    <i class="bi bi-chevron-down"></i>
                </button>
            </div>

            <div class="collapse show" id="transactionHistory">
                <div class="card-body p-0">
                    <table class="table table-hover table-bordered align-middle mb-0">
                        <thead class="table-primary text-center">
                            <tr>
                                <th>Date</th>
                                <th>Type</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var tx in Model.Transactions)
                            {
                                <tr>
                                    <td>@tx.TransactionDate.ToString("dd-MM-yyyy")</td>
                                    <td>@tx.TransactionType</td>
                                    <td>
                                        <i class="fa-solid fa-indian-rupee-sign"></i>
                                        @tx.Amount.ToString("0.00")
                                    </td>
                                    <td class="text-center">
                                        @if (tx.Status == "Approved")
                                        {
                                            <span class="badge bg-success">Approved</span>
                                        }
                                        else if (tx.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">Pending</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@tx.Status</span>
                                        }
                                    </td>
                                    <td>@tx.Description</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center shadow-sm">
            <i class="bi bi-info-circle me-2"></i>No transactions found for your account.
        </div>
    }
    <hr />
    //Accounts
    @if (Model.Accounts != null && Model.Accounts.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="fa-solid fa-wallet"></i>Accounts</h5>
                <button class="btn btn-light btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#accountHistory" aria-expanded="false" aria-controls="accountHistory">
                    <i class="bi bi-chevron-down"></i>
                </button>
            </div>

            <div class="collapse show" id="accountHistory">
                <div class="card-body p-0">
                    <table class="table table-hover table-bordered align-middle mb-0">
                        <thead class="table-primary text-center">
                            <tr>
                                <th>Account Number</th>
                                <th>Account Type</th>
                                <th>Balance</th>
                                <th>Created Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var tx in Model.Accounts)
                            {
                                if (tx.Status == "Active")
                                {
                                    <tr>
                                        <td>@tx.AccountNumber</td>
                                        <td>@tx.AccountTypeName</td>
                                        <td>@tx.Balance</td>
                                        <td>@tx.CreatedDate.ToString("dd-MM-yyyy")</td>
                                    </tr>
                                }                             
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center shadow-sm">
            <i class="bi bi-info-circle me-2"></i>No active accounts found.
        </div>
    }
}